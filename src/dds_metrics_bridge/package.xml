<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dds_metrics_bridge</name>
  <version>0.1.0</version>
  <description>
    Surfaces low-level Cyclone DDS transport health (heartbeats, RTPS
    retransmits, throughput, discovery time) as standard ROS 2 topics, for
    live visualization in Foxglove Studio. See README.md for the full
    architecture.
  </description>
  <maintainer email="kaipismike1@gmail.com">Mike Kaipis</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>cyclonedds</depend>
  <depend>rmw_cyclonedds_cpp</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
